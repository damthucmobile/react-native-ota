# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO CUSTOM OTA SERVER (SUPABASE + CLOUDFLARE R2)
# ==============================================================================

PORT=4500

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH SUPABASE (Lấy từ Supabase Dashboard -> Project Settings -> API)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Key dùng phía Dashboard/Client (public safe):
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Key dùng cho Server xử lý backend (admin bypass RLS):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH CLOUDFLARE R2 (Lấy từ Cloudflare Dashboard -> R2 -> Manage R2 API Tokens)
# ------------------------------------------------------------------------------
# ID tài khoản Cloudflare (chuỗi hash 32 ký tự):
R2_ACCOUNT_ID=your_cloudflare_account_id
# R2 Access Key ID:
R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2 Secret Access Key:
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Tên Bucket bạn tạo trên R2 (vd: custom-ota-bundles):
R2_BUCKET_NAME=custom-ota-bundles
# Domain Public kết nối với Bucket R2 (vd: https://ota-cdn.yourdomain.com hoặc https://pub-xxx.r2.dev):
R2_PUBLIC_DOMAIN=https://pub-your-bucket-id.r2.dev

# ------------------------------------------------------------------------------
# 3. ADMIN FALLBACK TOKEN (Tùy chọn)
# ------------------------------------------------------------------------------
OTA_ADMIN_TOKEN=demo-secret
