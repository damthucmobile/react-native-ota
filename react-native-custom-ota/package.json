{
  "name": "react-native-custom-ota",
  "version": "1.0.0",
  "description": "Self-hosted OTA (Over-The-Air) update library for React Native with automatic rollback, similar to react-native-code-push",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "bin": {
    "custom-ota": "./bin/custom-ota.js"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "bin",
    "react-native.config.js",
    "RNCustomOTA.podspec",
    "README.md"
  ],
  "scripts": {
    "build": "npx tsc --declaration --outDir lib/typescript && npx tsc --module commonjs --outDir lib/commonjs && npx tsc --module esnext --outDir lib/module",
    "prepack": "npm run build"
  },
  "keywords": [
    "react-native",
    "ota",
    "code-push",
    "hot-update",
    "live-update",
    "self-hosted",
    "rollback"
  ],
  "author": "Custom OTA Team",
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "dependencies": {
    "react-native-fs": "^2.20.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0 || ^19.0.0",
    "@types/react-native": "^0.72.0",
    "typescript": "^5.0.0"
  }
}
